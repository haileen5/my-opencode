    border-radius: 9999px;
    filter: blur(60px);
    opacity: .55;
    pointer-events: none;
    will-change: transform;
}

/* ---- Marquee of thread dots (Canvas-like decoration) ---- */
.stitch-dots {
    background-image: radial-gradient(circle, currentColor 2px, transparent 2.5px);
    background-size: 18px 18px;
    opacity: .5;
}

/* ---- Gradient text (Google-style) ---- */
.stitch-gradient-text {
    background: linear-gradient(100deg, #F8B803 0%, #FF750F 30%, #F0304E 55%, #7C3AED 80%, #22D3EE 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    background-size: 200% auto;
    animation: stitch-shimmer 8s linear infinite;
}
[data-theme="dark"] .stitch-gradient-text {
    background: linear-gradient(100deg, #FCD34D 0%, #FB923C 30%, #FF6B81 55%, #A78BFA 80%, #67E8F9 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    background-size: 200% auto;
    animation: stitch-shimmer 8s linear infinite;
}

/* ---- Rounded "stitched" card ---- */
.stitch-card {
    position: relative;
    border-radius: 1.75rem;
    background: color-mix(in oklab, var(--color-base-100) 82%, transparent);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    border: 1px solid color-mix(in oklab, var(--color-base-content) 12%, transparent);
    box-shadow: 0 20px 60px -20px rgba(0,0,0,.25);
}

/* Keep scrollbar pretty + consistent in both themes */

/* =====================================================================
   Glassmorphism (حالت شیشه‌ای) — کل محتوای رابط
   Uses DaisyUI theme tokens (--color-base-100 / --color-base-content) so
   the theme selector (dark / light / synthwave / fantasy / luxury) keeps
   working automatically. color-mix() re-tints the glass for every theme.
   Applied only to the main "surface" elements (not tiny controls) to
   stay light — backdrop-filter is GPU-accelerated at a moderate 12px.
   Add class="glass" anywhere for an extra glass panel.
   ===================================================================== */
@layer components {
    .glass {
        background-color: color-mix(in oklab, var(--color-base-100) 70%, transparent);
        -webkit-backdrop-filter: blur(12px) saturate(160%);
        backdrop-filter: blur(12px) saturate(160%);
        border: 1px solid color-mix(in oklab, var(--color-base-content) 14%, transparent);
        box-shadow: 0 8px 32px -12px rgba(0, 0, 0, 0.28);
    }
    .glass-strong {
        background-color: color-mix(in oklab, var(--color-base-100) 55%, transparent);
        -webkit-backdrop-filter: blur(16px) saturate(180%);
        backdrop-filter: blur(16px) saturate(180%);
        border: 1px solid color-mix(in oklab, var(--color-base-content) 16%, transparent);
        box-shadow: 0 12px 40px -10px rgba(0, 0, 0, 0.34);
    }
}

/* Apply glass globally to the major surfaces — no Blade/vendor edits needed.
   !important overrides maryUI/daisyUI's own bg-base-100 on these elements. */
.card,
.modal-box,
.navbar,
.dropdown-content,
.menu,
.popover,
.toast,
.alert,
.stat,
.drawer-side {
    background-color: color-mix(in oklab, var(--color-base-100) 70%, transparent) !important;
    -webkit-backdrop-filter: blur(12px) saturate(160%) !important;
    backdrop-filter: blur(12px) saturate(160%) !important;
    border: 1px solid color-mix(in oklab, var(--color-base-content) 14%, transparent) !important;
    box-shadow: 0 8px 32px -12px rgba(0, 0, 0, 0.28) !important;
}

/* Alert/toast text must stay readable on the glass background above.
   That rule replaces the variant background (alert-warning etc.) with a
   base-100 glass panel, but text color stays --color-*-content — which DaisyUI
   designs FOR the bright variant background. Measured against base-100:
   error-content 1.01:1, success-content 1.58:1, warning-content 1.71:1 in the
   dark theme (unreadable); light themes read fine against white, which is why
   the bug only shows in dark mode.
   Fix: keep the semantic hue but anchor it to --color-base-content (which every
   DaisyUI theme guarantees contrast against base-100). 30% variant color was
   measured across all 7 enabled themes (light, dark, synthwave, coffee,
   cupcake, fantasy, luxury) — worst case 6.90:1 (coffee/success), all pass
