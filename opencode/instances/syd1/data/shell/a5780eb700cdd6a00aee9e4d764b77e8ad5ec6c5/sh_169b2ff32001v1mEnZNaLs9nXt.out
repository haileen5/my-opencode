371:          # This .env feeds BOTH the app and scripts/build-env-e2e.sh, which
372:          # copies APP_KEY/DB_PASSWORD/REDIS_PASSWORD into .env.e2e without
377:      - name: Build .env.e2e (secret-safe)
378:        # CI redis is passwordless, so build-env-e2e.sh leaves the EXAMPLE
380:        # `set -a; source .env.e2e` in e2e-test.sh chokes on the `<...>`
386:          bash scripts/build-env-e2e.sh
387:          sed -i -E 's/^((REDIS_PASSWORD|DB_PASSWORD|DB_USERNAME)=.*)<[^>]*>(.*)/\1\3/; s/^((REDIS_PASSWORD|DB_PASSWORD|DB_USERNAME)=)[[:space:]]*$/\1/' .env.e2e
388:          grep -qE '^[^#]*<[^>]*>' .env.e2e && { echo "leftover <...> placeholder in .env.e2e"; exit 1; } || true
