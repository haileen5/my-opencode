        radial-gradient(circle at 50% 90%, rgba(255,117,15,0.08), transparent 45%);
    background-size: 44px 44px, 44px 44px, 100% 100%, 100% 100%, 100% 100%;
    transition: background-color 0.3s ease, background-image 0.3s ease;
}

/* Dark theme (dark/synthwave/coffee). #1224: `coffee` is a dark pole (daisyUI
   declares color-scheme: dark) but had no rule here, so it fell through to the
   light cream base above and washed out every glass surface — measured glass
   card 2.60:1 and glass modal 4.25:1. With this group: 7.05:1. */
[data-theme="dark"] .stitch-bg-fixed,
[data-theme="synthwave"] .stitch-bg-fixed,
[data-theme="coffee"] .stitch-bg-fixed,
.dark .stitch-bg-fixed {
    background-color: #140C1E;
    background-image:
        linear-gradient(to right, rgba(255,255,255,0.045) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255,255,255,0.045) 1px, transparent 1px),
        radial-gradient(circle at 20% 20%, rgba(167,139,250,0.14), transparent 40%),
        radial-gradient(circle at 80% 30%, rgba(34,211,238,0.12), transparent 45%),
        radial-gradient(circle at 50% 90%, rgba(255,117,15,0.10), transparent 45%);
    background-size: 44px 44px, 44px 44px, 100% 100%, 100% 100%, 100% 100%;
}

/* Fantasy theme (light theme variant) */
[data-theme="fantasy"] .stitch-bg-fixed {
    background-color: #FDFAF3;
    background-image:
        linear-gradient(to right, rgba(27,27,24,0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(27,27,24,0.05) 1px, transparent 1px),
        radial-gradient(circle at 20% 20%, rgba(248,184,3,0.12), transparent 40%),
        radial-gradient(circle at 80% 30%, rgba(240,172,184,0.14), transparent 45%),
        radial-gradient(circle at 50% 90%, rgba(255,117,15,0.10), transparent 45%);
    background-size: 44px 44px, 44px 44px, 100% 100%, 100% 100%, 100% 100%;
}

/* Luxury theme */
[data-theme="luxury"] .stitch-bg-fixed {
    background-color: #1a1a2e;
    background-image:
        linear-gradient(to right, rgba(255,215,0,0.06) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255,215,0,0.06) 1px, transparent 1px),
        radial-gradient(circle at 20% 20%, rgba(255,215,0,0.15), transparent 40%),
        radial-gradient(circle at 80% 30%, rgba(255,100,100,0.12), transparent 45%),
        radial-gradient(circle at 50% 90%, rgba(100,200,255,0.10), transparent 45%);
    background-size: 44px 44px, 44px 44px, 100% 100%, 100% 100%, 100% 100%;
}

/* ---- Floating blobs container ---- */
.stitch-blobs {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
}

/* ---- Individual blob (generated via JS) ---- */
.stitch-blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(80px);
    opacity: 0.4;
    pointer-events: none;
    will-change: transform, opacity;
    animation: stitch-drift 20s ease-in-out infinite;
}

/* Blob color variants for light theme */
[data-theme="light"] .stitch-blob.blob-1,
[data-theme="fantasy"] .stitch-blob.blob-1,
:not([data-theme="dark"]):not([data-theme="synthwave"]):not([data-theme="coffee"]):not([data-theme="luxury"]) .stitch-blob.blob-1 {
    background: radial-gradient(circle at 30% 30%, #F8B803, #FF750F);
}
[data-theme="light"] .stitch-blob.blob-2,
[data-theme="fantasy"] .stitch-blob.blob-2,
:not([data-theme="dark"]):not([data-theme="synthwave"]):not([data-theme="coffee"]):not([data-theme="luxury"]) .stitch-blob.blob-2 {
    background: radial-gradient(circle at 30% 30%, #F0304E, #7C3AED);
}
[data-theme="light"] .stitch-blob.blob-3,
[data-theme="fantasy"] .stitch-blob.blob-3,
:not([data-theme="dark"]):not([data-theme="synthwave"]):not([data-theme="coffee"]):not([data-theme="luxury"]) .stitch-blob.blob-3 {
    background: radial-gradient(circle at 30% 30%, #22D3EE, #7C3AED);
}

/* Blob color variants for dark theme */
[data-theme="dark"] .stitch-blob.blob-1,
[data-theme="synthwave"] .stitch-blob.blob-1,
[data-theme="coffee"] .stitch-blob.blob-1,
.dark .stitch-blob.blob-1 {
    background: radial-gradient(circle at 30% 30%, #A78BFA, #67E8F9);
}
[data-theme="dark"] .stitch-blob.blob-2,
[data-theme="synthwave"] .stitch-blob.blob-2,
[data-theme="coffee"] .stitch-blob.blob-2,
.dark .stitch-blob.blob-2 {
    background: radial-gradient(circle at 30% 30%, #FB923C, #FF6B81);
}
[data-theme="dark"] .stitch-blob.blob-3,
[data-theme="synthwave"] .stitch-blob.blob-3,
[data-theme="coffee"] .stitch-blob.blob-3,
.dark .stitch-blob.blob-3 {
    background: radial-gradient(circle at 30% 30%, #FCD34D, #A78BFA);
}

/* Blob color variants for luxury theme */
[data-theme="luxury"] .stitch-blob.blob-1 {
    background: radial-gradient(circle at 30% 30%, #FFD700, #FFA500);
}
[data-theme="luxury"] .stitch-blob.blob-2 {
    background: radial-gradient(circle at 30% 30%, #FF6B6B, #FFD700);
}
[data-theme="luxury"] .stitch-blob.blob-3 {
    background: radial-gradient(circle at 30% 30%, #00D4FF, #FFD700);
}

/* Drift animation with different delays for each blob */
.stitch-blob.blob-1 { animation-delay: 0s; animation-duration: 22s; }
.stitch-blob.blob-2 { animation-delay: -7s; animation-duration: 28s; }
.stitch-blob.blob-3 { animation-delay: -14s; animation-duration: 34s; }

/* Respect prefers-reduced-motion */
@media (prefers-reduced-motion: reduce) {
    .stitch-blob {
        animation: none !important;
    }
    .stitch-bg-fixed {
        transition: none !important;
    }
}

/* Ensure body content stays above background */
